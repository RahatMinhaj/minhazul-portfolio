# Public hostname only, without https:// or a trailing slash.
DOMAIN=portfolio.example.com

# The database URL uses the internal Compose service name `database`.
# URL-encode special characters in the password when placing it in this URL.
POSTGRES_DB=minhazul_portfolio
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=replace-with-a-long-database-password
DATABASE_URL=postgresql://portfolio_user:replace-with-a-long-database-password@database:5432/minhazul_portfolio

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Required only for the portfolio chatbot.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Used only by the initial seed command.
ADMIN_NAME=Minhazul Islam
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-initial-password
