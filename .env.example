# Public canonical URL used for metadata, sitemap entries, and absolute links.
NEXT_PUBLIC_SITE_URL=

# PostgreSQL connection string. Required once the database layer is enabled.
DATABASE_URL=

# One-time seed credentials for the initial administrator. Never use a real
# password in this example file or commit the populated values.
ADMIN_NAME=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secret used to protect authenticated sessions. Use a long random value.
AUTH_SECRET=

# Server-only Google AI Studio credentials for the grounded portfolio chatbot.
# Gemini offers a free tier; never expose this value with a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional fallback. openrouter/free automatically routes across currently
# available free text models when Gemini is rate-limited or unavailable.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
