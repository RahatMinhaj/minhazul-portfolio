generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
  APPRENTICESHIP
  OTHER
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         UserRole       @default(ADMIN)
  active       Boolean        @default(true)
  sessions     AdminSession[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([active, role])
}

model AdminSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model AuthAttempt {
  id              String    @id @default(cuid())
  keyHash         String    @unique
  failureCount    Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
}

model Profile {
  id                 String   @id @default(cuid())
  fullName           String
  professionalTitle  String
  shortBio           String
  longBio            Json?
  email              String?
  phone              String?
  location           String?
  availabilityStatus String?
  profileImage       String?
  yearsOfExperience  Decimal? @db.Decimal(4, 1)
  currentCompany     String?
  currentRole        String?
  preferredTheme     String?
  heroContent        Json?
  currentFocus       String?
  learningGoals      String[]
  engineeringValues  String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SocialLink {
  id        String  @id @default(cuid())
  platform  String
  label     String
  url       String  @unique
  icon      String?
  sortOrder Int     @default(0)
  visible   Boolean @default(true)

  @@index([visible, sortOrder])
}

model Experience {
  id               String          @id @default(cuid())
  company          String
  position         String
  employmentType   EmploymentType?
  location         String?
  startDate        DateTime?
  endDate          DateTime?
  currentlyWorking Boolean         @default(false)
  richDescription  Json?
  achievements     String[]
  technologies     String[]
  companyLogo      String?
  sortOrder        Int             @default(0)
  featured         Boolean         @default(false)
  visible          Boolean         @default(true)
  relatedProjects  Project[]

  @@index([visible, sortOrder])
  @@index([featured, visible])
  @@index([currentlyWorking])
}

model Education {
  id          String    @id @default(cuid())
  institution String
  college     String?
  degree      String
  field       String?
  startDate   DateTime?
  endDate     DateTime?
  grade       String?
  description Json?
  modules     String[]  @default([])
  logo        String?
  sortOrder   Int       @default(0)
  visible     Boolean   @default(true)

  @@index([visible, sortOrder])
}

model SkillCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  icon        String?
  sortOrder   Int     @default(0)
  visible     Boolean @default(true)
  skills      Skill[]

  @@index([visible, sortOrder])
}

model Skill {
  id                String        @id @default(cuid())
  categoryId        String
  name              String        @unique
  slug              String        @unique
  icon              String?
  proficiency       Int?
  yearsOfExperience Decimal?      @db.Decimal(4, 1)
  highlighted       Boolean       @default(false)
  sortOrder         Int           @default(0)
  visible           Boolean       @default(true)
  category          SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId, visible, sortOrder])
  @@index([highlighted, visible])
}

model Project {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  shortDescription String
  richDescription  Json?
  problemStatement Json?
  solution         Json?
  architecture     Json?
  challenges       Json?
  outcomes         Json?
  role             String?
  projectType      String?
  status           ProjectStatus @default(DRAFT)
  startDate        DateTime?
  endDate          DateTime?
  clientName       String?
  companyName      String?
  thumbnail        String?
  coverImage       String?
  gallery          String[]
  technologies     String[]
  githubUrl        String?
  liveUrl          String?
  caseStudyUrl     String?
  featured         Boolean       @default(false)
  sortOrder        Int           @default(0)
  visible          Boolean       @default(true)
  experienceId     String?
  experience       Experience?   @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([visible, sortOrder])
  @@index([status, visible])
  @@index([featured, visible])
  @@index([experienceId])
}

model Certification {
  id               String    @id @default(cuid())
  name             String
  issuer           String
  issueDate        DateTime?
  expiryDate       DateTime?
  credentialId     String?
  credentialUrl    String?
  certificateImage String?
  description      String?
  category         String?
  sortOrder        Int       @default(0)
  featured         Boolean   @default(false)
  visible          Boolean   @default(true)

  @@unique([name, issuer])
  @@index([visible, sortOrder])
  @@index([featured, visible])
}

model BlogPost {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String
  content        Json
  coverImage     String?
  tags           String[]
  status         BlogStatus @default(DRAFT)
  featured       Boolean    @default(false)
  publishedAt    DateTime?
  readingTime    Int?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([featured, status])
}

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    ContactMessageStatus @default(NEW)
  readAt    DateTime?
  repliedAt DateTime?
  archivedAt DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

enum ChatTurnRole {
  user
  assistant
}

enum JobApplicationStatus {
  DRAFT
  GENERATED
  READY
  SENDING
  SENT
  FAILED
  ARCHIVED
}

enum EmailDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  UNKNOWN
}

model ThemeDefinition {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  description   String?
  previewImage  String?
  configuration Json
  isDefault     Boolean  @default(false)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, sortOrder])
  @@index([isDefault, active])
}

model SiteSettings {
  id                        String   @id @default(cuid())
  siteName                  String
  siteDescription           String
  logo                      String?
  favicon                   String?
  defaultTheme              String
  primaryCTA                Json?
  secondaryCTA              Json?
  contactEnabled            Boolean  @default(true)
  blogEnabled               Boolean  @default(true)
  playgroundEnabled         Boolean  @default(true)
  analyticsEnabled          Boolean  @default(false)
  maintenanceMode           Boolean  @default(false)
  footerText                String?
  seoTitle                  String?
  seoDescription            String?
  seoImage                  String?
  engineeringSectionLabel      String   @default("01 / Engineering signature")
  engineeringLinkLabel         String   @default("Full skill map")
  engineeringCoreLabel         String   @default("Core strengths")
  engineeringCoreDescription   String   @default("Lead stack for architecture and delivery.")
  engineeringInventoryLabel    String   @default("Technology inventory")
  engineeringScrollLabel       String   @default("Scroll to explore")
  emailSignature           Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model ChatSession {
  id           String     @id @default(cuid())
  sessionToken String     @unique
  clientHash   String
  messageCount Int        @default(0)
  status       String     @default("active")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  turns        ChatTurn[]

  @@index([clientHash, updatedAt])
  @@index([updatedAt])
}

model ChatTurn {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      ChatTurnRole
  content   String
  sources   Json?
  provider  String?
  model     String?
  status    String      @default("completed")
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model JobApplication {
  id              String                @id @default(cuid())
  companyName     String
  roleTitle       String
  recipientEmail  String?
  contactName     String?
  sourceUrl       String?
  circularContent String                @default("")
  jobDescription  String
  status          JobApplicationStatus  @default(DRAFT)
  tone            String?
  notes           String?
  customCvPath    String?
  customCvName    String?
  lastGeneratedAt DateTime?
  sentAt          DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  artifacts       JobApplicationArtifact[]
  generations     JobApplicationGeneration[]
  deliveries      JobApplicationDelivery[]

  @@index([status, updatedAt])
  @@index([companyName, roleTitle])
}

model JobApplicationArtifact {
  id            String   @id @default(cuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          String
  customKind    String?
  title         String?
  content       String
  format        String   @default("MARKDOWN")
  sortOrder     Int      @default(0)
  generated     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([applicationId, kind])
}

model JobApplicationGeneration {
  id             String   @id @default(cuid())
  applicationId  String
  application    JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  provider       String
  model          String
  promptVersion  String
  inputSnapshot  Json
  outputSnapshot Json?
  status         String
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  @@index([applicationId, createdAt])
}

model JobApplicationDelivery {
  id                String              @id @default(cuid())
  applicationId     String
  application       JobApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status            EmailDeliveryStatus @default(PENDING)
  idempotencyKey    String              @unique
  provider          String
  providerMessageId String?
  fromAddress       String
  toAddress         String
  replyTo           String?
  subjectSnapshot   String
  textSnapshot      String
  htmlSnapshot      String?
  attachmentName    String?
  attachmentHash    String?
  attemptCount      Int                 @default(0)
  lastError         String?
  createdAt         DateTime            @default(now())
  sentAt            DateTime?

  @@index([applicationId, createdAt])
  @@index([status, createdAt])
}

model SavedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  label     String?
  useCount  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([useCount])
}

model VisitorEvent {
  id          String   @id @default(cuid())
  eventType   String
  pathname    String
  referrer    String?
  sessionHash String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([pathname, createdAt])
  @@index([sessionHash])
}

model UseItem {
  id          String  @id @default(cuid())
  category    String
  name        String
  description String?
  url         String?
  icon        String?
  sortOrder   Int     @default(0)
  visible     Boolean @default(true)

  @@unique([category, name])
  @@index([visible, category, sortOrder])
}

model MediaAsset {
  id        String   @id @default(cuid())
  provider  String
  url       String   @unique
  altText   String
  mimeType  String?
  width     Int?
  height    Int?
  sizeBytes Int?
  createdAt DateTime @default(now())

  @@index([provider, createdAt])
}
